# iOS release lanes (BUILD_PLAN.md REL-1). Run from apps/sousvite/ios:
#
#   BUNDLE_GEMFILE=../Gemfile bundle exec fastlane <lane>
#
# `.github/workflows/release.yaml` runs `beta` after `flutter build ios
# --config-only` has written the version, build number, and dart-defines.
#
# Environment:
#   APP_STORE_CONNECT_KEY_ID, APP_STORE_CONNECT_ISSUER_ID,
#   APP_STORE_CONNECT_API_KEY   the App Store Connect API key (.p8 contents)
#   MATCH_PASSWORD              decrypts the certificates repo
# plus SSH access to the certificates repo (a deploy key in CI).

default_platform(:ios)

APP_IDENTIFIER = "com.tytaniumdev.sousvite"
# The share extension (ios/ShareExtension) is its own bundle with its own
# profile.
EXTENSION_IDENTIFIER = "#{APP_IDENTIFIER}.ShareExtension"
TEAM_ID = "F2HXQGU2CC"

# Each target, by Xcode target name: its bundle id and match's profile name.
SIGNED_TARGETS = {
  "Runner" => APP_IDENTIFIER,
  "ShareExtension" => EXTENSION_IDENTIFIER
}.freeze

def profile_name(identifier)
  "match AppStore #{identifier}"
end

# The API key every Apple-facing action below accepts.
def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
    issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
    key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY")
  )
end

platform :ios do
  desc "Create the App Store profile in the certificates repo if it is missing"
  desc "(needs write access to that repo). Safe to run again: it changes nothing"
  desc "once the profile exists."
  lane :certs do
    setup_ci
    api_key = asc_api_key
    # match needs each bundle id registered before it can make a profile.
    SIGNED_TARGETS.each_value do |identifier|
      next if Spaceship::ConnectAPI::BundleId.find(identifier)

      Spaceship::ConnectAPI::BundleId.create(
        name: identifier.split(".").last,
        platform: "IOS",
        identifier: identifier
      )
    end
    match(api_key: api_key, readonly: false)
  end

  desc "Build a signed release and upload it to TestFlight"
  lane :beta do
    # A temporary keychain on CI, so match can install the certificate.
    setup_ci
    api_key = asc_api_key
    match(api_key: api_key, readonly: true)

    # The Xcode project uses automatic signing for local runs. Release builds
    # sign manually with match's profile, so xcodebuild never asks for Apple's
    # cloud-managed certificate (that needs an Admin API key; ours is App
    # Manager).
    SIGNED_TARGETS.each do |target, identifier|
      update_code_signing_settings(
        path: "Runner.xcodeproj",
        targets: [target],
        use_automatic_signing: false,
        team_id: TEAM_ID,
        code_sign_identity: "Apple Distribution",
        profile_name: profile_name(identifier),
        bundle_identifier: identifier
      )
    end

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: SIGNED_TARGETS.values.to_h do |identifier|
          [identifier, profile_name(identifier)]
        end
      },
      archive_path: "../build/ios/Sousvite.xcarchive",
      output_directory: "../build/ios/ipa",
      output_name: "Sousvite.ipa"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
