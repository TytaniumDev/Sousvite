# iOS release lanes (BUILD_PLAN.md REL-1). Run from apps/sousvite/ios:
#
#   BUNDLE_GEMFILE=../Gemfile bundle exec fastlane <lane>
#
# `.github/workflows/release.yaml` runs `beta` after `flutter build ios
# --config-only` has written the version, build number, and dart-defines.
#
# Environment:
#   APP_STORE_CONNECT_KEY_ID, APP_STORE_CONNECT_ISSUER_ID,
#   APP_STORE_CONNECT_API_KEY   the App Store Connect API key (.p8 contents)
#   MATCH_PASSWORD              decrypts the certificates repo
# plus SSH access to the certificates repo (a deploy key in CI).

default_platform(:ios)

APP_IDENTIFIER = "com.tytaniumdev.sousvite"
TEAM_ID = "F2HXQGU2CC"
PROFILE_NAME = "match AppStore #{APP_IDENTIFIER}"

# The App ID capabilities each bundle id needs, by App Store Connect API
# name (Sign in with Apple is APPLE_ID_AUTH). Keep this in step with
# ios/Runner/Runner.entitlements: a profile only grants the entitlements its
# App ID has turned on, and the archive fails on any it lacks.
#
# The API can't turn on App Attest, so it is on by hand in the developer
# portal (Identifiers, com.tytaniumdev.sousvite). After turning a capability
# on there, run `certs` with MATCH_FORCE=true to remake the profiles.
CAPABILITIES = {
  APP_IDENTIFIER => %w[APPLE_ID_AUTH]
}.freeze

# Turns on any capability from CAPABILITIES that an App ID is missing.
# Returns true when it changed something, because existing profiles then
# lack the new entitlement and have to be made again.
def ensure_capabilities
  changed = false
  CAPABILITIES.each do |identifier, types|
    bundle_id = Spaceship::ConnectAPI::BundleId.find(identifier)
    UI.user_error!("#{identifier} is not registered with Apple") unless bundle_id
    enabled = bundle_id.get_capabilities.map(&:capability_type)
    (types - enabled).each do |type|
      UI.message("Turning on #{type} for #{identifier}")
      bundle_id.create_capability(type)
      changed = true
    end
  end
  changed
end

# The API key every Apple-facing action below accepts.
def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
    issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
    key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY")
  )
end

platform :ios do
  desc "Turn on the App ID capabilities in CAPABILITIES, then create the App"
  desc "Store profile in the certificates repo (needs write access to it)."
  desc "Safe to run again: it changes nothing once both are in place. Profiles"
  desc "are made again when a capability was turned on, or with MATCH_FORCE=true."
  lane :certs do
    setup_ci
    api_key = asc_api_key
    changed = ensure_capabilities
    match(api_key: api_key, readonly: false, force: changed || ENV["MATCH_FORCE"] == "true")
  end

  desc "Build a signed release and upload it to TestFlight"
  lane :beta do
    # A temporary keychain on CI, so match can install the certificate.
    setup_ci
    api_key = asc_api_key
    match(api_key: api_key, readonly: true)

    # The Xcode project uses automatic signing for local runs. Release builds
    # sign manually with match's profile, so xcodebuild never asks for Apple's
    # cloud-managed certificate (that needs an Admin API key; ours is App
    # Manager).
    update_code_signing_settings(
      path: "Runner.xcodeproj",
      targets: ["Runner"],
      use_automatic_signing: false,
      team_id: TEAM_ID,
      code_sign_identity: "Apple Distribution",
      profile_name: PROFILE_NAME,
      bundle_identifier: APP_IDENTIFIER
    )

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: { APP_IDENTIFIER => PROFILE_NAME }
      },
      archive_path: "../build/ios/Sousvite.xcarchive",
      output_directory: "../build/ios/ipa",
      output_name: "Sousvite.ipa"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
